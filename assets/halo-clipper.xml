<?xml version="1.0" encoding="UTF-8"?>
<!-- Registers the .haloedit project file so file managers give it the Halo
     Clipper icon and open it with Halo Clipper on double-click. Installed to
     /usr/share/mime/packages/ and registered with update-mime-database. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-haloedit">
    <comment>Halo Clipper edit</comment>
    <!-- The file is JSON inside. Declaring it a subclass of application/json,
         plus a strong glob weight, makes every resolver (GIO, KDE's
         QMimeDatabase, libmagic-based xdg-mime) return this specific type
         instead of sniffing the contents as plain JSON. -->
    <sub-class-of type="application/json"/>
    <glob pattern="*.haloedit" weight="80"/>
    <icon name="application-x-haloedit"/>
    <generic-icon name="application-x-haloedit"/>
  </mime-type>
</mime-info>
