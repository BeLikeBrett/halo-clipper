[Desktop Entry]
Type=Application
Version=1.0
Name=Halo Clipper
GenericName=Video Clipper
Comment=Fast, simple video trimming and clipping for Linux
Exec=halo-clipper %F
TryExec=halo-clipper
Icon=halo-clipper
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=video;clip;trim;cut;edit;encode;
StartupNotify=true
StartupWMClass=halo-clipper
MimeType=video/mp4;video/x-matroska;video/quicktime;video/webm;video/x-msvideo;video/x-m4v;
